# ─────────────────────────────────────────────────────────────────────────────
# Auryx website — environment variables
# Copy to .env.local (development) or set in your hosting provider (production).
# NEVER commit real values. Everything secret stays server-side only
# (no variable here is prefixed NEXT_PUBLIC_ except the public site URL).
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL, used for links in emails, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://auryx.net

# ── Database ─────────────────────────────────────────────────────────────────
# Production: a PostgreSQL connection string (Neon, Supabase, RDS, self-hosted…)
#   DATABASE_URL=postgres://user:password@host:5432/auryx?sslmode=require
# Local development: leave unset (or "pglite:./.data/pglite") to use the
# embedded PGlite database — no Docker or Postgres install needed.
DATABASE_URL=
# Optional: "disable" to turn off TLS (only for a local Postgres); pool size.
DATABASE_SSL=
DATABASE_POOL_MAX=5

# ── Authentication ───────────────────────────────────────────────────────────
# Random secret (min. 32 chars) for signing admin sessions and encrypting MFA
# secrets. Generate with:  openssl rand -base64 48
# Changing it signs out all admins and invalidates stored MFA setups.
AUTH_SECRET=

# ── Email (contact inquiries, booking confirmations & notifications) ─────────
# "smtp" to send, "console" to only log (default when SMTP_HOST is unset).
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Auryx Software <info@auryx.net>"
# Google Workspace: smtp.gmail.com:587 with an App Password for the sending
# account, or smtp-relay.gmail.com (see README → Email setup).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Development only: print full email bodies to the server console.
EMAIL_DEBUG=

# ── Google Calendar (consultation booking) ───────────────────────────────────
# OAuth client + refresh token for the Workspace account that owns the
# consultation calendar (see README → Google Calendar setup).
# If unset, bookings are stored locally and no calendar events are created.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to book into: "primary" or a calendar ID (e.g. consultations@auryx.net)
GOOGLE_CALENDAR_ID=primary

# ── AI chat assistant ────────────────────────────────────────────────────────
# anthropic (default when a key is set) | openai-compatible | none
# With "none" / no key, the assistant answers from approved FAQs only.
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional model override. Default for anthropic: claude-haiku-4-5
AI_MODEL=
# Only for AI_PROVIDER=openai-compatible (base URL of a /chat/completions API)
AI_BASE_URL=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Protects GET /api/cron/retention (daily data-retention purge).
# Generate with:  openssl rand -hex 32
CRON_SECRET=
